# Deliveroo server
HOST=http://localhost:8080

# BDI agent - required
TOKEN=replace_with_bdi_agent_token

# LLM agent - its own Deliveroo token, so the two agents play as two players
LLM_TOKEN=

# OpenAI-compatible endpoint used by the LLM agent
LITELLM_BASE_URL=https://llm.bears.disi.unitn.it/v1
LITELLM_API_KEY=
LOCAL_MODEL=llama-3.3-70b-lmstudio

# Optional: only accept missions from this player name or id
MISSION_SENDER=
